# ============================================================
# Apex Tech Academy — PRODUCTION Environment Variables
# Set ALL these values in your Render dashboard (never commit this file with real values)
# ============================================================

PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com → Your Cluster → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/apex-tech-academy?retryWrites=true&w=majority

# JWT — generate strong random secrets (e.g. run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=30m
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_STRONG_RANDOM_64_CHAR_STRING
JWT_REFRESH_EXPIRES_IN=30d

# Frontend URL (your Vercel URL)
CLIENT_URL=https://apex-tech-academy.vercel.app

# Backend URL (your Render URL)
SERVER_URL=https://apex-tech-academy-api.onrender.com

# Email — Gmail App Password (recommended for production)
# Setup: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your.gmail@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM=Apex Tech Academy <no-reply@apextechacademy.com>

# Paystack (live keys from https://dashboard.paystack.com)
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Certificate signing key
CERT_SIGNATURE_KEY=REPLACE_WITH_STRONG_RANDOM_STRING

# Admin setup token
ADMIN_SETUP_TOKEN=REPLACE_WITH_STRONG_RANDOM_STRING
