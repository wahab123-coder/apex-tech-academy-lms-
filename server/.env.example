# ============================================================
# Apex Tech Academy — Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/apex-tech-academy

# JWT
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=30d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Email (for notifications, admission letters, etc.)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=no-reply@apextechacademy.com
EMAIL_PASS=your_email_password
EMAIL_FROM=Apex Tech Academy <no-reply@apextechacademy.com>

# Payment Provider — Paystack
# Get your keys from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYMENT_WEBHOOK_SECRET=your_webhook_secret

# File Storage (e.g. Cloudinary / AWS S3)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Certificate / PDF Generation (optional)
CERT_SIGNATURE_KEY=your_certificate_signing_key

# Admin Setup (one-time secure seed)
ADMIN_SETUP_TOKEN=replace_with_a_secure_random_token
